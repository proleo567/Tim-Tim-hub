end)

local function findNearestReadyEggBillboard(excludeSet)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local originPos = hrp and hrp.Position or Vector3.new()

    local bestPart, bestDist, bestName, bestBillboard = nil, math.huge, nil, nil

    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BillboardGui") then
            local combinedText = ""
            for _, child in ipairs(inst:GetDescendants()) do
                if child:IsA("TextLabel") then
                    combinedText = combinedText .. " " .. child.Text
                end
            end
            local lowerText = combinedText:lower()
            if lowerText:find("ready") then
                local part = getBillboardPart(inst)
                if part then
                    local eggName = nil
                    for _, name in ipairs(EGG_ORDER) do
                        if combinedText:find(name) then
                            eggName = name
                            break
                        end
                    end
                    if not (eggName and excludeSet[eggName]) then
                        local dist = (part.Position - originPos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestPart = part
                            bestName = eggName
                            bestBillboard = inst
                        end
                    end
                end
            end
        end
    end

    return bestPart, bestName, bestBillboard
end

local function findHatchPromptForBillboard(billboardInst, fallbackPart)
    local container = billboardInst
    for _ = 1, 6 do
        if not container then break end
        for prompt in pairs(HatchRegistry) do
            if prompt.Parent and prompt:IsDescendantOf(container) then
                return prompt
            end
        end
        container = container.Parent
    end

    if fallbackPart then
        local bestPrompt, bestDist = nil, 5
        for prompt in pairs(HatchRegistry) do
            if prompt.Parent then
                local p = getPromptPart(prompt)
                if p then
                    local dist = (p.Position - fallbackPart.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestPrompt = prompt
                    end
                end
            end
        end
        return bestPrompt
    end
    return nil
end

local CachedRanchPos = nil

local function scanRanchPosition()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BillboardGui") then
            local combined = ""
            for _, child in ipairs(inst:GetDescendants()) do
                if child:IsA("TextLabel") then
                    combined = combined .. " " .. child.Text
                end
            end
            if combined:lower():find("ranch") then
                local part = getBillboardPart(inst)
                if part then return part.Position end
            end
        end
    end
    return nil
end

task.spawn(function()
    while true do
        local pos = scanRanchPosition()
        if pos then CachedRanchPos = pos end
        task.wait(2)
    end
end)

local function findRanchPosition()
    return scanRanchPosition() or CachedRanchPos
end

--// SHARED: INVENTORY TRACKING
local function findInventoryTool(name)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    local containers = {}
    if backpack then table.insert(containers, backpack) end
    if char then table.insert(containers, char) end

    for _, container in ipairs(containers) do
        local exact = container:FindFirstChild(name)
        if exact and exact:IsA("Tool") then return exact end
    end
    for _, container in ipairs(containers) do
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and child.Name:sub(1, #name) == name then
                return child
            end
        end
    end
    return nil
end

local function findInventoryToolMatchingKG(name, minKG)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local tool = nil
    for _, t in ipairs(backpack:GetChildren()) do
        if t:IsA("Tool") and t.Name:sub(1, #name) == name then
            tool = t
            break
        end
    end
    if not tool then return nil end
    if not minKG or minKG <= 0 then return tool end

    local kg = findSlotKGForName(name) or getInstanceKG(tool)
    if kg and kg >= minKG then
        return tool
    end
    return nil
end

