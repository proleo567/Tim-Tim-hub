local SUFFIXES = {
    { "Qi", 1e18 }, { "Qa", 1e15 }, { "T", 1e12 }, { "B", 1e9 }, { "M", 1e6 }, { "K", 1e3 },
}

-- FIXED: previously returned the raw number even when the suffix wasn't
-- recognized (e.g. "47055.0x", your luck multiplier), which is how it
-- got confused for cash. Now an unrecognized suffix means "not a valid
-- amount" and returns nil instead of guessing.
local function parseAbbreviatedNumber(str)
    if not str then return nil end
    str = tostring(str):gsub("%s+", ""):gsub(",", ""):gsub("%$", "")
    if str == "" then return nil end
    local numPart, suffix = str:match("^([%d%.]+)(%a*)$")
    if not numPart then return tonumber(str) end
    local n = tonumber(numPart)
    if not n then return nil end
    if suffix == "" then return n end
    for _, pair in ipairs(SUFFIXES) do
        if suffix:lower() == pair[1]:lower() then
            return n * pair[2]
        end
    end
    return nil
end

local function formatAbbreviated(n)
    if not n then return "?" end
    for _, pair in ipairs(SUFFIXES) do
        if n >= pair[2] then
            return string.format("%.2f%s", n / pair[2], pair[1])
        end
    end
    return string.format("%.2f", n)
end

local function stripRichText(s)
    return (s:gsub("<[^>]->", ""))
end

local function getHumanoid()
