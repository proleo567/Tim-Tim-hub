local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function firePrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    if typeof(fireproximityprompt) ~= "function" then return false end
    return pcall(function()
        fireproximityprompt(prompt, prompt.HoldDuration)
    end)
end

local function getPromptPart(prompt)
    local parent = prompt.Parent
    if not parent then return nil end
    if parent:IsA("BasePart") then return parent end
    if parent:IsA("Attachment") then return parent.Parent end
    return parent:FindFirstAncestorWhichIsA("BasePart")
end

local function getBillboardPart(billboard)
    local adornee = billboard.Adornee or billboard.Parent
    if not adornee then return nil end
    if adornee:IsA("BasePart") then return adornee end
    return adornee:FindFirstChildWhichIsA("BasePart", true) or adornee:FindFirstAncestorWhichIsA("BasePart")
end

--// SHARED: WORLD EGG TRACKING
local EggESP = { Enabled = false }
local EggRegistry = {}

local function isPickupPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end
    local text = (prompt.ObjectText or ""):lower()
    return text:find("egg") ~= nil
end

local function addEggPrompt(prompt)
    if EggRegistry[prompt] then return end
    if not isPickupPrompt(prompt) then return end

    local part = getPromptPart(prompt)
    if not part then return end

    local eggName = prompt.ObjectText

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 215, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = part
    highlight.Parent = part
    highlight.Enabled = EggESP.Enabled

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TimTimEggESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 150, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = EggESP.Enabled
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.Text = eggName
    label.Parent = billboard

    EggRegistry[prompt] = {part = part, name = eggName, highlight = highlight, billboard = billboard, label = label}

    prompt.AncestryChanged:Connect(function(_, parent)
        if not parent then
            local data = EggRegistry[prompt]
            if data then
                if data.highlight then data.highlight:Destroy() end
                if data.billboard then data.billboard:Destroy() end
                EggRegistry[prompt] = nil
            end
        end
    end)
end

for _, inst in ipairs(Workspace:GetDescendants()) do
    if inst:IsA("ProximityPrompt") then addEggPrompt(inst) end
end

Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("ProximityPrompt") then
        task.defer(addEggPrompt, inst)
    end
end)

RunService.Heartbeat:Connect(function()
