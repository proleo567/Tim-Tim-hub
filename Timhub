local function firePrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    if typeof(fireproximityprompt) ~= "function" then return false end
    return pcall(function()
        fireproximityprompt(prompt, prompt.HoldDuration)
    end)
end

local function getPromptPart(prompt)
    local parent = prompt.Parent
    if not parent then return nil end
    if parent:IsA("BasePart") then return parent end
    if parent:IsA("Attachment") then return parent.Parent end
    return parent:FindFirstAncestorWhichIsA("BasePart")
end

local function getBillboardPart(billboard)
    local adornee = billboard.Adornee or billboard.Parent
    if not adornee then return nil end
    if adornee:IsA("BasePart") then return adornee end
    return adornee:FindFirstChildWhichIsA("BasePart", true) or adornee:FindFirstAncestorWhichIsA("BasePart")
end

local function getInstanceKG(inst)
    if not inst then return nil end
    local attrNames = { "KG", "Kg", "kg", "Weight", "Mass" }
    for _, attrName in ipairs(attrNames) do
        local ok, val = pcall(function() return inst:GetAttribute(attrName) end)
        if ok and val then return tonumber(val) end
    end
    local ok, descendants = pcall(function() return inst:GetDescendants() end)
    if ok then
        for _, child in ipairs(descendants) do
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                local n = child.Name:lower()
                if n:find("kg") or n:find("weight") then
                    return child.Value
                end
            elseif child:IsA("TextLabel") then
                local num, suf = child.Text:match("([%d%.]+)%s*(%a*)%s*KG")
                if num then
                    return parseAbbreviatedNumber(num .. (suf or ""))
                end
            end
        end
    end
    return nil
end

local function findSlotKGForName(name)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    for _, inst in ipairs(playerGui:GetDescendants()) do
        if inst:IsA("GuiObject") then
            local nameMatches = (inst.Name == name) or (inst.Name:sub(1, #name) == name)
            if not nameMatches then
                for _, child in ipairs(inst:GetChildren()) do
                    if child:IsA("TextLabel") and (child.Text == name or child.Text:sub(1, #name) == name) then
                        nameMatches = true
                        break
                    end
                end
            end
            if nameMatches then
                for _, child in ipairs(inst:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        local num, suf = child.Text:match("([%d%.,]+)%s*(%a*)%s*KG")
                        if num then
                            return parseAbbreviatedNumber(num .. (suf or ""))
                        end
                    end
                end
            end
        end
    end
    return nil
end

--// SHARED: WORLD EGG TRACKING
local EggESP = { Enabled = false, DisplayKG = false }
local EggRegistry = {}

local function isPickupPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end
    local text = (prompt.ObjectText or ""):lower()
    return text:find("egg") ~= nil
end

local function addEggPrompt(prompt)
    if EggRegistry[prompt] then return end
    if not isPickupPrompt(prompt) then return end

    local part = getPromptPart(prompt)
    if not part then return end

    local eggName = prompt.ObjectText
    local kgSource = prompt:FindFirstAncestorOfClass("Model") or part

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 215, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = part
    highlight.Parent = part
    highlight.Enabled = EggESP.Enabled

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TimTimEggESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 160, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = EggESP.Enabled
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.Text = eggName
    label.Parent = billboard

    EggRegistry[prompt] = {part = part, name = eggName, kgSource = kgSource, highlight = highlight, billboard = billboard, label = label}

    prompt.AncestryChanged:Connect(function(_, parent)
        if not parent then
            local data = EggRegistry[prompt]
            if data then
                if data.highlight then data.highlight:Destroy() end
                if data.billboard then data.billboard:Destroy() end
                EggRegistry[prompt] = nil
            end
        end
    end)
end

for _, inst in ipairs(Workspace:GetDescendants()) do
    if inst:IsA("ProximityPrompt") then addEggPrompt(inst) end
end

Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("ProximityPrompt") then
        task.defer(addEggPrompt, inst)
    end
end)

RunService.Heartbeat:Connect(function()
    if not EggESP.Enabled then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for prompt, data in pairs(EggRegistry) do
        if prompt.Parent and data.part and data.part.Parent and hrp then
            local dist = (data.part.Position - hrp.Position).Magnitude
            local text = data.name .. " [" .. math.floor(dist) .. "m]"
            if EggESP.DisplayKG then
                local kg = getInstanceKG(data.kgSource)
                if kg then
                    text = text .. " (" .. formatAbbreviated(kg) .. " KG)"
                end
            end
            data.label.Text = text
        end
    end
end)

local function getNearestEggByName(name)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local originPos = hrp and hrp.Position or Vector3.new()

    local closestPrompt, closestPart, closestDist = nil, nil, math.huge
    for prompt, data in pairs(EggRegistry) do
        if data.name == name and prompt.Parent and data.part and data.part.Parent then
            local dist = (data.part.Position - originPos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestPrompt = prompt
                closestPart = data.part
            end
        end
    end
    return closestPrompt, closestPart
end

