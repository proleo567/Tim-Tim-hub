    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for prompt, data in pairs(EggRegistry) do
        if prompt.Parent and data.part and data.part.Parent and hrp then
            local dist = (data.part.Position - hrp.Position).Magnitude
            data.label.Text = data.name .. " [" .. math.floor(dist) .. "m]"
        end
    end
end)

local function getNearestEggByName(name)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local originPos = hrp and hrp.Position or Vector3.new()

    local closestPrompt, closestPart, closestDist = nil, nil, math.huge
    for prompt, data in pairs(EggRegistry) do
        if data.name == name and prompt.Parent and data.part and data.part.Parent then
            local dist = (data.part.Position - originPos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestPrompt = prompt
                closestPart = data.part
            end
        end
    end
    return closestPrompt, closestPart
end

--// SHARED: HATCH PROMPT TRACKING
local HatchRegistry = {}

local function isHatchPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return false end
    local text = ((prompt.ActionText or "") .. " " .. (prompt.ObjectText or "")):lower()
    return text:find("hatch") ~= nil
end

local function trackHatchPrompt(prompt)
    if HatchRegistry[prompt] then return end
    if not isHatchPrompt(prompt) then return end
    HatchRegistry[prompt] = true
    prompt.AncestryChanged:Connect(function(_, parent)
        if not parent then HatchRegistry[prompt] = nil end
    end)
end

for _, inst in ipairs(Workspace:GetDescendants()) do
    if inst:IsA("ProximityPrompt") then trackHatchPrompt(inst) end
end

Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("ProximityPrompt") then
        task.defer(trackHatchPrompt, inst)
    end
end)

local function findNearestReadyEggBillboard(excludeSet)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local originPos = hrp and hrp.Position or Vector3.new()

    local bestPart, bestDist, bestName = nil, math.huge, nil

    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BillboardGui") then
            local combinedText = ""
            for _, child in ipairs(inst:GetDescendants()) do
                if child:IsA("TextLabel") then
                    combinedText = combinedText .. " " .. child.Text
                end
            end
            local lowerText = combinedText:lower()
            if lowerText:find("ready") then
                local part = getBillboardPart(inst)
                if part then
                    local eggName = nil
                    for _, name in ipairs(EGG_ORDER) do
                        if combinedText:find(name) then
                            eggName = name
                            break
                        end
                    end
                    if not (eggName and excludeSet[eggName]) then
                        local dist = (part.Position - originPos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestPart = part
                            bestName = eggName
                        end
                    end
                end
            end
        end
    end

    return bestPart, bestName
end

local function findNearbyHatchPrompt(part, maxDist)
    local bestPrompt, bestDist = nil, maxDist
    for prompt in pairs(HatchRegistry) do
        if prompt.Parent then
            local p = getPromptPart(prompt)
            if p then
                local dist = (p.Position - part.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestPrompt = prompt
                end
            end
        end
    end
    return bestPrompt
end

local CachedRanchPos = nil

local function scanRanchPosition()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BillboardGui") then
            local combined = ""
            for _, child in ipairs(inst:GetDescendants()) do
                if child:IsA("TextLabel") then
                    combined = combined .. " " .. child.Text
                end
            end
            if combined:lower():find("ranch") then
                local part = getBillboardPart(inst)
                if part then return part.Position end
            end
        end
    end
    return nil
end

task.spawn(function()
    while true do
        local pos = scanRanchPosition()
        if pos then CachedRanchPos = pos end
        task.wait(2)
    end
end)

local function findRanchPosition()
    return scanRanchPosition() or CachedRanchPos
end

--// SHARED: INVENTORY TRACKING
local function findInventoryTool(name)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool end
    end
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChild(name)
        if tool and tool:IsA("Tool") then return tool end
    end
    return nil
end

