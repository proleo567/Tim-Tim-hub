--// MAIN TAB - AUTO PLACE
MainTab:CreateDivider({ text = "Auto Place" })

local AutoPlace = { Enabled = false, SelectedEggs = {}, Active = false }

local function placeEggOnce(tool)
    local hum = getHumanoid()
    if not hum then return end
    hum:EquipTool(tool)
    task.wait(0.2)
    pcall(function() tool:Activate() end)
end

local function checkPlotFullText()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    for _, inst in ipairs(playerGui:GetDescendants()) do
        if inst:IsA("TextLabel") then
            local current, maxN = inst.Text:match("(%d+)%s*/%s*(%d+)%s*Eggs In Plot")
            if current and maxN then
                return tonumber(current) >= tonumber(maxN)
            end
        end
    end
    return nil
end

-- Same priority idea as Auto Collect: among your selected egg types,
-- picks the highest tier that's actually sitting in your inventory right now.
local function pickPriorityInventoryEgg()
    for i = #EGG_ORDER, 1, -1 do
        local name = EGG_ORDER[i]
        if AutoPlace.SelectedEggs[name] then
            local tool = findInventoryTool(name)
            if tool then
                return name, tool
            end
        end
    end
    return nil
end

local function runAutoPlaceLoop()
    if AutoPlace.Active then return end
    AutoPlace.Active = true

    task.spawn(function()
        while AutoPlace.Enabled do
            local alreadyFull = checkPlotFullText()
            if alreadyFull == true then
                task.wait(1.5)
            else
                local eggName, tool = pickPriorityInventoryEgg()
                if not tool then
                    task.wait(0.5)
                else
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local sawFull = false
                    local conn
                    if playerGui then
                        conn = playerGui.DescendantAdded:Connect(function(inst)
                            task.wait()
                            if inst:IsA("TextLabel") then
                                local current, maxN = inst.Text:match("(%d+)%s*/%s*(%d+)%s*Eggs In Plot")
                                if current and maxN and tonumber(current) >= tonumber(maxN) then
                                    sawFull = true
                                end
                            end
                        end)
                    end

                    placeEggOnce(tool)
                    task.wait(0.4)
                    if conn then conn:Disconnect() end

                    if sawFull then
                        window:Notify({ title = "Auto Place", content = "Plot is full — pausing." })
                        task.wait(2)
                    else
                        task.wait(0.3)
                    end
                end
            end
        end
        AutoPlace.Active = false
    end)
end

