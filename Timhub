local AutoUpgradeLuck = { Enabled = false, CashThreshold = 0, Active = false }

local function getCurrentCashFromUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    local camera = Workspace.CurrentCamera
    local vw, vh = 1280, 720
    if camera then
        vw, vh = camera.ViewportSize.X, camera.ViewportSize.Y
    end

    local best, bestScore = nil, -math.huge
    for _, inst in ipairs(playerGui:GetDescendants()) do
        if inst:IsA("TextLabel") or inst:IsA("TextButton") then
            local raw = stripRichText(inst.Text)
            if raw:match("^%d[%d,]*%.?%d*%a*$") and not raw:find("%$") and not raw:find("/s") then
                local num = parseAbbreviatedNumber(raw)
                if num and num > 0 then
                    local pos = inst.AbsolutePosition
                    local inTopRight = (pos.X > vw * 0.5) and (pos.Y < vh * 0.35)
                    local score = inst.TextSize + (inTopRight and 10000 or 0)
                    if score > bestScore then
                        bestScore = score
                        best = num
                    end
                end
            end
        end
    end
    return best
end

local function getCurrentCash()
    local uiCash = getCurrentCashFromUI()
    if uiCash then return uiCash end

    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        for _, name in ipairs({ "Cash", "Money", "Coins", "Clovers" }) do
            local stat = stats:FindFirstChild(name)
            if stat then return tonumber(stat.Value) end
        end
    end
    return nil
end

local function findMaxLuckButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    for _, inst in ipairs(playerGui:GetDescendants()) do
        if inst:IsA("GuiButton") then
            local isMax = false
            if inst:IsA("TextButton") and inst.Text:lower():match("^%s*max%s*$") then
                isMax = true
            else
                for _, child in ipairs(inst:GetDescendants()) do
                    if child:IsA("TextLabel") and child.Text:lower():match("^%s*max%s*$") then
                        isMax = true
                        break
                    end
                end
            end

            if isMax then
                local ancestor = inst.Parent
                for _ = 1, 6 do
                    if not ancestor then break end
                    for _, sib in ipairs(ancestor:GetDescendants()) do
                        if sib:IsA("TextLabel") and sib.Text:lower():find("hatch luck") then
                            return inst
                        end
                    end
                    ancestor = ancestor.Parent
                end
            end
        end
    end
    return nil
end

local function clickGuiButton(button)
    local fired = false
    pcall(function()
        for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
            conn:Fire()
            fired = true
        end
    end)
    if not fired then
        pcall(function()
            local pos = button.AbsolutePosition + button.AbsoluteSize / 2
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
            fired = true
        end)
    end
    return fired
end

local lastDebugNotify = 0

local function runAutoUpgradeLuckLoop()
    if AutoUpgradeLuck.Active then return end
    AutoUpgradeLuck.Active = true

    task.spawn(function()
        while AutoUpgradeLuck.Enabled do
            local cash = getCurrentCash()
            local button = findMaxLuckButton()

            if os.clock() - lastDebugNotify > 5 then
                lastDebugNotify = os.clock()
                window:Notify({
                    title = "Auto Upgrade Luck",
                    content = "Cash: " .. (cash and formatAbbreviated(cash) or "not found")
                        .. " | MAX button: " .. (button and "found" or "not found"),
                })
            end

            if AutoUpgradeLuck.CashThreshold <= 0 then
                if button then clickGuiButton(button) end
                task.wait(2)
            elseif cash and cash >= AutoUpgradeLuck.CashThreshold then
                if button then
                    clickGuiButton(button)
                    task.wait(0.15)
                    clickGuiButton(button)
                    task.wait(2)
                else
                    task.wait(1)
                end
            else
                task.wait(1)
            end
        end
        AutoUpgradeLuck.Active = false
    end)
end

