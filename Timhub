local AutoCollect = {
    Enabled = false,
    SelectedEggs = {},
    Active = false,
}

local function pickPriorityEgg()
    for i = #EGG_ORDER, 1, -1 do
        local name = EGG_ORDER[i]
        if AutoCollect.SelectedEggs[name] then
            local prompt, part = getNearestEggByName(name)
            if prompt and part then
                return name, prompt, part
            end
        end
    end
    return nil
end

local AutoCollectToggle

local function runAutoCollectLoop()
    if AutoCollect.Active then return end
    AutoCollect.Active = true

    task.spawn(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            AutoCollect.Active = false
            AutoCollect.Enabled = false
            if AutoCollectToggle then AutoCollectToggle:Set(false, true) end
            return
        end

        local plotPos = findRanchPosition()
        if not plotPos then
            window:Notify({ title = "Auto Collect", content = "Couldn't find your ranch yet — using your current spot." })
            plotPos = hrp.Position
        end

        do
            local function running() return AutoCollect.Enabled and hrp.Parent ~= nil end
            local restoreCollision = beginNoclip(char)
            hum.PlatformStand = true
            smoothFlyTo(hrp, function() return plotPos end, FLY_SPEED, 4, running)
            hum.PlatformStand = false
            restoreCollision()
        end

        while AutoCollect.Enabled do
            local eggName, prompt, part = pickPriorityEgg()

            if not eggName then
                task.wait(0.5)
            else
                char = LocalPlayer.Character
                hrp = char and char:FindFirstChild("HumanoidRootPart")
                hum = char and char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    local promptGone = false
                    local ancestryConn
                    ancestryConn = prompt.AncestryChanged:Connect(function(_, parent)
                        if not parent then promptGone = true end
                    end)

                    local function running()
                        return AutoCollect.Enabled and hrp.Parent ~= nil
                    end

                    local restoreCollision = beginNoclip(char)
                    hum.PlatformStand = true

                    smoothFlyTo(hrp, function()
                        if not part.Parent then return nil end
                        return part.Position + Vector3.new(0, 3, 0)
                    end, FLY_SPEED, 4, running)

                    local attempts = 0
                    while AutoCollect.Enabled and prompt.Parent and not promptGone and attempts < 30 do
                        firePrompt(prompt)
                        attempts += 1
                        task.wait(0.1)
                    end
                    ancestryConn:Disconnect()

                    if running() then
                        smoothFlyTo(hrp, function() return plotPos end, FLY_SPEED, 4, running)
                    end

                    hum.PlatformStand = false
                    restoreCollision()
                else
                    task.wait(0.5)
                end
            end
        end

        AutoCollect.Active = false
    end)
end

