local Tracer = { Enabled = false, Targets = {} }

local TracerFolder = Instance.new("Folder")
TracerFolder.Name = "TimTimTracers"
TracerFolder.Parent = Workspace

local TracerColors = {
    Color3.fromRGB(255, 0, 0),
    Color3.fromRGB(0, 255, 170),
    Color3.fromRGB(255, 220, 0),
    Color3.fromRGB(120, 170, 255),
    Color3.fromRGB(255, 140, 255),
}

local TracerBeams = {}

local function getOriginAttachment()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local attach = hrp:FindFirstChild("TimTimTracerOrigin")
    if not attach then
        attach = Instance.new("Attachment")
        attach.Name = "TimTimTracerOrigin"
        attach.Parent = hrp
    end
    return attach
end

local function getOrCreateTracerBeam(eggName, index)
    local data = TracerBeams[eggName]
    if data then return data end

    local proxyPart = Instance.new("Part")
    proxyPart.Name = "TimTimTracerProxy"
    proxyPart.Anchored = true
    proxyPart.CanCollide = false
    proxyPart.CanQuery = false
    proxyPart.CanTouch = false
    proxyPart.Transparency = 1
    proxyPart.Size = Vector3.new(0.2, 0.2, 0.2)
    proxyPart.Parent = TracerFolder

    local proxyAttachment = Instance.new("Attachment")
    proxyAttachment.Parent = proxyPart

    local beam = Instance.new("Beam")
    beam.Width0 = 0.2
    beam.Width1 = 0.2
    beam.FaceCamera = true
    beam.Color = ColorSequence.new(TracerColors[((index - 1) % #TracerColors) + 1])
    beam.Transparency = NumberSequence.new(0.1)
    beam.Attachment1 = proxyAttachment
    beam.Enabled = false
    beam.Parent = proxyPart

    data = {beam = beam, proxyPart = proxyPart, proxyAttachment = proxyAttachment}
    TracerBeams[eggName] = data
    return data
end

RunService.Heartbeat:Connect(function()
    if not Tracer.Enabled or #Tracer.Targets == 0 then
        for _, data in pairs(TracerBeams) do data.beam.Enabled = false end
        return
    end

    local origin = getOriginAttachment()
    local active = {}

    for i, eggName in ipairs(Tracer.Targets) do
        active[eggName] = true
        local data = getOrCreateTracerBeam(eggName, i)
        local beam = data.beam

        if not origin then
            beam.Enabled = false
        else
            beam.Attachment0 = origin
            local _, part = getNearestEggByName(eggName)
            if part then
                data.proxyPart.CFrame = CFrame.new(part.Position)
                beam.Enabled = true
            else
                beam.Enabled = false
            end
        end
    end

    for eggName, data in pairs(TracerBeams) do
        if not active[eggName] then data.beam.Enabled = false end
    end
end)

