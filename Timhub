--// FLIGHT HELPERS (shared by Auto Collect and Auto Hatch)
local function beginNoclip(char)
    local original = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            original[part] = part.CanCollide
            part.CanCollide = false
        end
    end
    local restored = false
    return function()
        if restored then return end
        restored = true
        for part, val in pairs(original) do
            if part and part.Parent then part.CanCollide = val end
        end
    end
end

local FLY_SPEED = 1200

local function smoothFlyTo(hrp, getTargetPos, speed, tolerance, shouldContinue)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "TimTimFlight"
    bv.MaxForce = Vector3.new(1, 1, 1) * math.huge
    bv.P = 10000
    bv.Velocity = Vector3.new()
    bv.Parent = hrp

    local reached = false
    while shouldContinue() do
        local dt = RunService.Heartbeat:Wait()
        if not hrp or not hrp.Parent then break end
        local targetPos = getTargetPos()
        if not targetPos then break end
        local delta = targetPos - hrp.Position
        local dist = delta.Magnitude
        if dist <= tolerance then
            reached = true
            break
        end
        local desiredSpeed = math.min(speed, dist * 8)
        bv.Velocity = delta.Unit * desiredSpeed
    end

    bv.Velocity = Vector3.new()
    bv:Destroy()
    return reached
end

