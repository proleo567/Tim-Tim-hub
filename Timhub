local AutoHatch = { Enabled = false, Active = false, Exclude = {} }

local function runAutoHatchLoop()
    if AutoHatch.Active then return end
    AutoHatch.Active = true

    task.spawn(function()
        while AutoHatch.Enabled do
            local part, eggName = findNearestReadyEggBillboard(AutoHatch.Exclude)

            if not part then
                task.wait(0.3)
            else
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    window:Notify({ title = "Auto Hatch", content = (eggName or "Egg") .. " ready — flying to it." })

                    local function running()
                        return AutoHatch.Enabled and hrp.Parent ~= nil
                    end

                    local restoreCollision = beginNoclip(char)
                    hum.PlatformStand = true

                    smoothFlyTo(hrp, function()
                        if not part.Parent then return nil end
                        return part.Position + Vector3.new(0, 3, 0)
                    end, FLY_SPEED, 4, running)

                    hum.PlatformStand = false
                    restoreCollision()

                    local prompt = findNearbyHatchPrompt(part, 15)
                    if prompt then
                        local attempts = 0
                        while AutoHatch.Enabled and prompt.Parent and prompt.Enabled and attempts < 50 do
                            firePrompt(prompt)
                            attempts += 1
                            task.wait(0.1)
                        end
                    end
                else
                    task.wait(0.3)
                end
            end
        end
        AutoHatch.Active = false
    end)
end

